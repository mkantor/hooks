#!/bin/sh

# Verify the commit message.


unset CDPATH
set -o errexit

# Not clever enough to work when run from a symlink or ". script.sh".
THIS_DIR=$(cd -P "$(dirname "$0")" && pwd)

# Expect the name of the file holding the proposed commit message as the first 
# argument.
COMMIT_MESSAGE_FILE=$1

# git doesn't expose the active `--cleanup` mode, so honor the `commit.cleanup` 
# config and assume it wasn't overridden on the command line:
#  	- verbatim, whitespace: leave the message alone (git will keep comments)
#  	- scissors: truncate from the "------------------------ >8 ----…" line 
#  	  onwards; comments above the scissors are preserved
#  	- strip, default: drop comment lines
CLEANUP_MODE=$(git config --get commit.cleanup 2>/dev/null || true)
if [ -z "$CLEANUP_MODE" ]
then
	CLEANUP_MODE="default"
fi

COMMENT_CHARACTER=$(git config --get core.commentChar 2>/dev/null || true)
if [ -z "$COMMENT_CHARACTER" ] || [ "$COMMENT_CHARACTER" = "auto" ]
then
	# `auto` lets git pick a character not used at the start of any line; the 
	# first (and usual) choice is '#'.
	COMMENT_CHARACTER="#"
fi

case "$CLEANUP_MODE" in
	verbatim|whitespace) STRIP_COMMENTS=0; CUT_AT_SCISSORS=0 ;;
	scissors)            STRIP_COMMENTS=0; CUT_AT_SCISSORS=1 ;;
	strip|default)       STRIP_COMMENTS=1; CUT_AT_SCISSORS=0 ;;
	*) echo 1>&2 "$0: Unrecognized commit.cleanup mode '$CLEANUP_MODE'." ; exit 1 ;;
esac

# Build a cleaned copy of the message for the format check, so it doesn't trip 
# over content that git will strip before committing.
CLEANED_COMMIT_MESSAGE=$(
	awk \
		-v commentCharacter="$COMMENT_CHARACTER" \
		-v strip="$STRIP_COMMENTS" \
		-v cutScissors="$CUT_AT_SCISSORS" \
		'
			{
				if (cut) next
				if (substr($0, 1, length(commentCharacter)) == commentCharacter) {
					if (cutScissors && index($0, "------------------------ >8 ------------------------") > 0) {
						cut = 1
						next
					}
					if (strip) next
				}
				print
			}
		' \
		< "$COMMIT_MESSAGE_FILE"
)

echo "$CLEANED_COMMIT_MESSAGE" | "$THIS_DIR/utilities/validate_commit_message_format.sh"

# If aspell is present, check spelling.
if command -v aspell > /dev/null 2>&1
then
	# If a cspell.json file exists at the repo root, try to load its custom words 
	# into a dictionary for aspell. Any failure here is non-fatal (spell-checking 
	# proceeds without the extra words).
	PERSONAL_DICTIONARY=""
	REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
	if [ -n "$REPO_ROOT" ] && [ -r "$REPO_ROOT/cspell.json" ]
	then
		if command -v jq > /dev/null 2>&1
		then
			CSPELL_WORDS=$(
				jq \
					-r '(.words // []) + (.ignoreWords // []) | .[]' "$REPO_ROOT/cspell.json" \
					2>/dev/null \
					|| true
			)
			if [ -n "$CSPELL_WORDS" ]
			then
				PERSONAL_DICTIONARY=$(
					mktemp "${TMPDIR:-/tmp}/commit-msg-aspell.XXXXXX" 2>/dev/null || true
				)
				if [ -n "$PERSONAL_DICTIONARY" ]
				then
					trap 'rm -f "$PERSONAL_DICTIONARY"' EXIT

					ASPELL_LOCALE=$(aspell config lang)
					# aspell's personal dictionary header wants a base language code 
					# ("en"), not a locale ("en_US"), so strip any suffix.
					ASPELL_LANGUAGE=${ASPELL_LOCALE%%_*}

					printf "personal_ws-1.1 %s 0\n%s\n" "$ASPELL_LANGUAGE" "$CSPELL_WORDS" \
						> "$PERSONAL_DICTIONARY"
				fi
			fi
		fi
	fi

	# Build aspell args mirroring the cleanup mode: in modes where git would 
	# strip comments, tell aspell to skip them via email mode (without modifying 
	# the file, so interactive corrections still land in the real commit 
	# message). In modes where comments are kept (verbatim/whitespace/scissors), 
	# let aspell spell-check them too. Note that with scissors mode, comments 
	# after the scissors line are stripped by git but still checked by aspell.
	set --
	if [ "$STRIP_COMMENTS" -eq 1 ]
	then
		set -- "$@" --mode=email --add-email-quote="$COMMENT_CHARACTER"
	fi
	if [ -n "$PERSONAL_DICTIONARY" ]
	then
		set -- "$@" --personal="$PERSONAL_DICTIONARY"
	fi

	# Since git hooks have a stdin of /dev/null, we need to manually get to the 
	# input device. When no TTY is attached (e.g. GUI clients), skip the check 
	# rather than failing the commit.
	if (: < /dev/tty) > /dev/null 2>&1
	then
		aspell check "$@" "$COMMIT_MESSAGE_FILE" < /dev/tty
	else
		echo 1>&2 "$0: No TTY available; skipping spell check."
	fi
fi
